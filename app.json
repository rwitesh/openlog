{
  "expo": {
    "name": "OpenLog",
    "slug": "openlog",
    "version": "1.3.10",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "openlog",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "17.0",
      "buildNumber": "16",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice entries on your timeline.",
        "NSLocationWhenInUseUsageDescription": "Attach your current location to entries.",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to timeline entries.",
        "NSPhotoLibraryAddUsageDescription": "Save photos from entries to your photo library."
      },
      "bundleIdentifier": "share.openlog.mobile"
    },
    "android": {
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#3264e6",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "share.openlog.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3264e6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1a2560",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to timeline entries."
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "react-native-file-viewer-turbo",
        {
          "mimeTypes": ["*/*"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attach your current location to entries."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn kotlin.MustUseReturnValues\n-dontwarn kotlinx.io.**\n-dontwarn kotlin.**"
          },
          "ios": {
            "ccacheEnabled": true
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "60437110-d992-4987-89c3-b7bc251edeb1"
      }
    },
    "owner": "rwitesh"
  }
}
