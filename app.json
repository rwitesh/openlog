{
  "expo": {
    "name": "Monolog",
    "slug": "monolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "monolog",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "15.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice entries on your timeline.",
        "NSLocationWhenInUseUsageDescription": "Attach your current location to entries.",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to timeline entries.",
        "NSPhotoLibraryAddUsageDescription": "Save photos from entries to your photo library."
      },
      "bundleIdentifier": "com.rwitesh.monolog"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#3264e6",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.rwitesh.monolog"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3264e6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1a2560",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to timeline entries."
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attach your current location to entries."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cc8b2ca6-1398-4758-8d6d-a05220e2c9eb"
      }
    }
  }
}
