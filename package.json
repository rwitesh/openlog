{
  "name": "openlog",
  "version": "1.3.10",
  "author": "Rwitesh Bera",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "lodash.debounce": "^4.0.8",
    "posthog-react-native": "^4.65.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-file-viewer-turbo": "^0.7.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:clean": "expo run:android --no-build-cache",
    "android:metro": "expo start --dev-client --android",
    "adb:devices": "adb devices -l",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081",
    "adb:logs": "adb logcat '*:S' ReactNativeJS:V ReactNative:V Expo:V",
    "eas:dev": "pnpm dlx --allow-build=dtrace-provider --allow-build=protobufjs eas-cli@latest build --platform android --profile development",
    "eas:prod": "pnpm dlx --allow-build=dtrace-provider --allow-build=protobufjs eas-cli@latest build --platform android --profile production",
    "expo:doctor": "pnpm dlx expo-doctor",
    "expo:fix": "pnpm expo install --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test scripts/test-*.mjs",
    "lint": "biome check src App.tsx index.ts",
    "lint:fix": "biome check --write src App.tsx index.ts",
    "assets:clean": "node scripts/clean-assets.js",
    "format": "biome format --write src App.tsx index.ts",
    "format:check": "biome format src App.tsx index.ts"
  },
  "private": true,
  "packageManager": "pnpm@12.4.1"
}
